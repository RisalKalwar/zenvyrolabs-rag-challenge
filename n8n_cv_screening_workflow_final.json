{
  "name": "CV Screening - Automated Result Routing (Webhook + Gmail) v2",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cv-screening",
        "options": {}
      },
      "id": "ac1cb7dd-c195-45fe-a5a5-6f38e2d7ac76",
      "name": "Webhook: Receive Evaluation Results",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -960,
        512
      ],
      "webhookId": "8f618440-8fd2-4676-a4df-0fb03473a59c",
      "notes": "Receives the POST from cv_screening_engine.send_to_n8n(). Copy this node's Production URL into your .env as N8N_WEBHOOK_URL."
    },
    {
      "parameters": {
        "jsCode": "const candidates = $input.first().json.body.candidates;\n\nreturn candidates.map(candidate => {\n  return { json: candidate };\n});"
      },
      "id": "c2fa5534-6026-43c4-980d-691e50a643e0",
      "name": "Split Out Candidates",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -736,
        512
      ],
      "notes": "Uses a Code node instead of the built-in Split Out node — pulls candidates from body.candidates (the Webhook node nests the parsed JSON payload under 'body') and returns one item per candidate."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 1
          },
          "conditions": [
            {
              "id": "email-flagged-cond",
              "leftValue": "={{ $json.email_flagged }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1737f97-abde-4fb1-b1c7-20f18dac0b84",
      "name": "Filter: Flagged for Manual Review",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -512,
        512
      ],
      "notes": "IF node (not Filter) — true output goes to Manual Review logging, false output continues to the Selected/Rejected routing."
    },
    {
